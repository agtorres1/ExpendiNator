<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/background">

    <!-- Header con título -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/widget_text" />
    </LinearLayout>

    <!-- Botón escanear con estilo mejorado -->
    <LinearLayout
        android:id="@+id/widget_scan_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/button_scan_background"
        android:padding="14dp"
        android:gravity="center"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/escanear_ticket"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/widget_on_mint"
            android:letterSpacing="0.02" />
    </LinearLayout>

    <!-- Resumen con cards mejoradas -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <!-- Card Hoy -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="12dp"
            android:gravity="center"
            android:layout_marginEnd="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_hoy"
                android:textSize="11sp"
                android:textColor="@color/widget_muted"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/widget_total_today"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_cero"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/widget_text" />
        </LinearLayout>

        <!-- Card Semana -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="12dp"
            android:gravity="center"
            android:layout_marginStart="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/semana"
                android:textSize="11sp"
                android:textColor="@color/widget_muted"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/widget_total_week"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_cero"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/widget_text" />
        </LinearLayout>
    </LinearLayout>

    <!-- Últimos gastos mejorado -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/card_background"
        android:padding="14dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ultimos_gastos"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/widget_muted"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/widget_expense_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="13sp"
            android:textColor="@color/widget_text"
            android:paddingVertical="3dp"
            android:ellipsize="end"
            android:maxLines="1" />

        <TextView
            android:id="@+id/widget_expense_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="13sp"
            android:textColor="@color/widget_text"
            android:paddingVertical="3dp"
            android:ellipsize="end"
            android:maxLines="1" />

        <TextView
            android:id="@+id/widget_expense_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="13sp"
            android:textColor="@color/widget_text"
            android:paddingVertical="3dp"
            android:ellipsize="end"
            android:maxLines="1" />
    </LinearLayout>

</LinearLayout>